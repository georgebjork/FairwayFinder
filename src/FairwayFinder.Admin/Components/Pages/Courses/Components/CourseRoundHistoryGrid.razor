@using FairwayFinder.Features.Data
@inject NavigationManager NavigationManager

<RadzenCard class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">Round History</RadzenText>
    <RadzenDataGrid TItem="RoundResponse" Data="@Rounds"
                    AllowFiltering="true"
                    FilterMode="FilterMode.Advanced"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Displaying page {0} of {1} (total {2} rounds)"
                    Style="cursor: pointer;"
                    @bind-Value=@_selectedRound
                    RowRender="@OnRowRender"
                    RowClick="@OnRoundRowClick">
        <Columns>
            <RadzenDataGridColumn TItem="RoundResponse" Property="DatePlayed" Title="Date Played" Width="150px">
                <Template Context="round">
                    @round.DatePlayed.ToString("MMM dd, yyyy")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RoundResponse" Property="Teebox.TeeboxName" Title="Teebox" />
            <RadzenDataGridColumn TItem="RoundResponse" Property="Teebox.Slope" Title="Slope/Rating" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="round">
                    @round.Teebox.Slope / @round.Teebox.Rating
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RoundResponse" Property="FullRound" Title="Holes" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="round">
                    @(round.FullRound ? "18" : "9")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RoundResponse" Property="Score" Title="Score" Width="100px" TextAlign="TextAlign.Center" />
            @if (ShowExclusionState)
            {
                <RadzenDataGridColumn TItem="RoundResponse" Title="Stats" Width="110px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                    <Template Context="round">
                        @if (round.ExcludeFromStats)
                        {
                            <RadzenBadge Text="Excluded" BadgeStyle="BadgeStyle.Warning" Shade="Shade.Lighter" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public List<RoundResponse>? Rounds { get; set; }

    /// <summary>
    /// Optional prefix prepended to round navigation URLs.
    /// When null, rounds navigate to "/round/{id}".
    /// When set (e.g. "/profile/{guid}"), rounds navigate to "{prefix}/round/{id}".
    /// </summary>
    [Parameter]
    public string? RoundUrlPrefix { get; set; }

    /// <summary>
    /// Shows an "Excluded" badge and dims rounds the owner has flagged ExcludeFromStats. The
    /// history lists every round played here, while the stats above it skip the excluded ones —
    /// the badge is what explains the difference.
    /// </summary>
    [Parameter]
    public bool ShowExclusionState { get; set; }

    private IList<RoundResponse> _selectedRound = [];

    private void OnRowRender(RowRenderEventArgs<RoundResponse> args)
    {
        if (ShowExclusionState && args.Data.ExcludeFromStats)
        {
            args.Attributes["style"] = "opacity: 0.6;";
        }
    }

    private void OnRoundRowClick(DataGridRowMouseEventArgs<RoundResponse> args)
    {
        if (args.Data is not null)
        {
            var prefix = string.IsNullOrEmpty(RoundUrlPrefix) ? "/rounds" : RoundUrlPrefix.TrimEnd('/');
            NavigationManager.NavigateTo($"{prefix}/{args.Data.RoundId}");
        }
    }
}
