@page "/"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.AdminOnly)]
@using Microsoft.Extensions.Diagnostics.HealthChecks
@using FairwayFinder.Features.Services.Admin
@using FairwayFinder.Admin.Components.Shared.Layout.Breadcrumb
@using FairwayFinder.Admin.Services
@inject AdminDashboardService DashboardService
@inject HealthCheckService HealthCheckService
@inject CircuitTrackingService CircuitTrackingService
@inject BreadcrumbState BreadcrumbState
@inject ILogger<Dashboard> Logger

<PageTitle>Overview</PageTitle>

<RadzenStack Gap="1.5rem">
    <PageHeader Title="Overview" Subtitle="@SnapshotText">
        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Click="LoadAsync" IsBusy="_loading" />
    </PageHeader>

    @if (_loading)
    {
        <RadzenStack AlignItems="AlignItems.Center" class="rz-p-8">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    }
    else if (_metrics is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" Title="Failed to load dashboard metrics">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@(_error ?? "An unexpected error occurred.")</RadzenText>
        </RadzenAlert>
    }
    else
    {
        @* ── Health + live connections ── *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.75rem">
            <RadzenLink Path="/health" class="ff-status">
                <span class="ff-status-dot" style="@HealthDotStyle()"></span>
                @HealthText()
            </RadzenLink>
            @if (_healthReport is not null)
            {
                @foreach (var entry in _healthReport.Entries)
                {
                    <RadzenBadge Text="@($"{entry.Key}: {entry.Value.Status}")"
                                 BadgeStyle="@HealthBadge(entry.Value.Status)" Shade="Shade.Lighter" />
                }
            }
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">
                @_liveConnections live @(_liveConnections == 1 ? "connection" : "connections")
            </RadzenText>
        </RadzenStack>

        @* ── Key metrics ── *@
        <ScorecardStrip>
            <ScorecardCell Label="Users" Value="@_metrics.Growth.TotalUsers.ToString()" Note="@($"{_metrics.Growth.NewUsersLast30Days} new in the last 30 days")" Tone="ScorecardTone.Brand" Href="/users" />
            <ScorecardCell Label="Activation" Value="@($"{_metrics.Growth.ActivationRatePercent}%")" Note="@($"{_metrics.Growth.ActivatedUsers} have logged a round")" Tone="ScorecardTone.Fairway" />
            <ScorecardCell Label="Dormant" Value="@_metrics.Growth.DormantUsers.ToString()" Note="Signed up, never played" Tone="ScorecardTone.Sand" />
            <ScorecardCell Label="Engagement" Value="@($"{_metrics.Growth.EngagementRatePercent}%")" Note="@($"{_metrics.Growth.ActiveUsers} active in the last 30 days")" Tone="ScorecardTone.Water" />
            <ScorecardCell Label="Rounds" Value="@_metrics.Activity.TotalRounds.ToString()" Note="@($"{_metrics.Activity.RoundsLast7Days} this week, {_metrics.Activity.RoundsLast30Days} in 30 days")" Tone="ScorecardTone.Fairway" Href="/rounds" />
            <ScorecardCell Label="Shot tracking" Value="@($"{_metrics.Activity.ShotTrackingAdoptionPercent}%")" Note="Of rounds track shots" Tone="ScorecardTone.Water" />
            <ScorecardCell Label="Pending invites" Value="@_metrics.Invites.PendingCount.ToString()" Note="@($"{_metrics.Invites.ClaimRatePercent}% claimed overall")" Tone="ScorecardTone.Brand" Href="/invites" />
            <ScorecardCell Label="Email confirmed" Value="@($"{_metrics.Growth.EmailConfirmedPercent}%")" Note="@($"{_metrics.Growth.EmailConfirmedCount} of {_metrics.Growth.TotalUsers} users")" />
        </ScorecardStrip>

        @* ── Charts ── *@
        <RadzenRow Gap="1rem" RowGap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenText TextStyle="TextStyle.H6">New signups, last 12 months</RadzenText>
                    <RadzenChart>
                        <RadzenColumnSeries Data="@_metrics.Growth.SignupsByMonth" CategoryProperty="Label" ValueProperty="Count" Title="Signups" Fill="var(--ff-brand)" />
                        <RadzenCategoryAxis Padding="20" LabelAutoRotation="-45" />
                        <RadzenValueAxis Min="0">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenText TextStyle="TextStyle.H6">Rounds played, last 12 months</RadzenText>
                    <RadzenChart>
                        <RadzenColumnSeries Data="@_metrics.Activity.RoundsByMonth" CategoryProperty="Label" ValueProperty="Count" Title="Rounds" Fill="var(--ff-fairway)" />
                        <RadzenCategoryAxis Padding="20" LabelAutoRotation="-45" />
                        <RadzenValueAxis Min="0">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* ── Lists ── *@
        <RadzenRow Gap="1rem" RowGap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenText TextStyle="TextStyle.H6">Most-played courses</RadzenText>
                    @if (_metrics.Activity.MostPlayedCourses.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" style="color: var(--rz-text-secondary-color);">No rounds yet.</RadzenText>
                    }
                    else
                    {
                        <RadzenStack Gap="0.5rem" class="rz-mt-2">
                            @foreach (var c in _metrics.Activity.MostPlayedCourses)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@c.CourseName</RadzenText>
                                    <RadzenBadge Text="@c.RoundCount.ToString()" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" />
                                </RadzenStack>
                            }
                        </RadzenStack>
                    }
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Recently joined</RadzenText>
                        <RadzenLink Text="All users" Path="/users" />
                    </RadzenStack>
                    <RadzenStack Gap="0.5rem" class="rz-mt-2">
                        @foreach (var u in _metrics.Growth.RecentlyJoined)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenStack Gap="0">
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Email : u.FullName)</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" style="color: var(--rz-text-secondary-color);">@u.CreatedOn.ToLocalTime().ToString("MMM d, yyyy")</RadzenText>
                                </RadzenStack>
                                @if (!u.IsEmailConfirmed)
                                {
                                    <RadzenBadge Text="Unverified" BadgeStyle="BadgeStyle.Warning" Shade="Shade.Lighter" />
                                }
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Recent invites</RadzenText>
                        <RadzenLink Text="All invites" Path="/invites" />
                    </RadzenStack>
                    @if (_metrics.Invites.RecentInvites.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" style="color: var(--rz-text-secondary-color);" class="rz-mt-2">No invites yet.</RadzenText>
                    }
                    else
                    {
                        <RadzenStack Gap="0.5rem" class="rz-mt-2">
                            @foreach (var i in _metrics.Invites.RecentInvites)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@i.Email</RadzenText>
                                    <RadzenBadge Text="@i.Status" BadgeStyle="@InviteBadge(i.Status)" Shade="Shade.Lighter" />
                                </RadzenStack>
                            }
                        </RadzenStack>
                    }
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    private bool _loading = true;
    private string? _error;
    private DashboardMetricsDto? _metrics;
    private HealthReport? _healthReport;
    private HealthStatus? _healthStatus;
    private int _liveConnections;

    protected override void OnInitialized()
    {
        BreadcrumbState.Set(
            new BreadcrumbItem("Overview")
        );
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        _liveConnections = CircuitTrackingService.ActiveCount;

        try
        {
            _metrics = await DashboardService.GetDashboardMetricsAsync();
        }
        catch (Exception ex)
        {
            _metrics = null;
            _error = ex.Message;
            Logger.LogError(ex, "Failed to load admin dashboard metrics");
        }

        try
        {
            _healthReport = await HealthCheckService.CheckHealthAsync();
            _healthStatus = _healthReport.Status;
        }
        catch
        {
            _healthStatus = HealthStatus.Unhealthy;
        }

        _loading = false;
    }

    private string? SnapshotText =>
        _metrics is null ? null : $"Snapshot taken {_metrics.GeneratedAtUtc.ToLocalTime():MMM d, yyyy 'at' HH:mm}";

    private string HealthText() => _healthStatus switch
    {
        HealthStatus.Healthy => "System healthy",
        HealthStatus.Degraded => "System degraded",
        null => "Health unknown",
        _ => "System unhealthy"
    };

    private string HealthDotStyle()
    {
        var color = _healthStatus switch
        {
            HealthStatus.Healthy => "var(--rz-success)",
            HealthStatus.Degraded => "var(--rz-warning)",
            _ => "var(--rz-danger)"
        };
        return $"background-color: {color};";
    }

    private static BadgeStyle HealthBadge(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => BadgeStyle.Success,
        HealthStatus.Degraded => BadgeStyle.Warning,
        _ => BadgeStyle.Danger
    };

    private static BadgeStyle InviteBadge(string status) => status switch
    {
        "Claimed" => BadgeStyle.Success,
        "Expired" => BadgeStyle.Danger,
        _ => BadgeStyle.Info
    };
}
