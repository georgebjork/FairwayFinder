@page "/system"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.AdminOnly)]
@using FairwayFinder.Admin.Components.Pages.SystemOps.Components
@using FairwayFinder.Admin.Components.Shared.Layout.Breadcrumb
@inject BreadcrumbState BreadcrumbState

<PageTitle>System Operations</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">System</RadzenText>
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="TGTR" Icon="sync">
                <TgtrAdminTab />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Course Import" Icon="cloud_download">
                <CourseImportTab />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Connections" Icon="cable">
                <WebSocketConnectionsTab />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    protected override void OnInitialized()
    {
        BreadcrumbState.Set(
            new BreadcrumbItem("Overview", "/"),
            new BreadcrumbItem("System")
        );
    }
}
