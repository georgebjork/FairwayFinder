@using FairwayFinder.Features.Services.Admin
@using FairwayFinder.Features.Services.Interfaces
@using FairwayFinder.Features.Helpers
@using FairwayFinder.Features.Data
@using FairwayFinder.Admin.Components.Shared.Dialogs
@inject DialogService DialogService
@inject UserAdminService UserAdminService
@inject IUsernameService UsernameService
@inject IPasswordResetService PasswordResetService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<RadzenTemplateForm TItem="EditUserModel" Data="_model" Submit="OnSubmit">
    <RadzenStack Gap="1.25rem">

        @* ── Identity ── *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenGravatar Email="@User.Email" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@User.Email</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" style="color: var(--rz-text-secondary-color);" class="rz-m-0">
                    Joined @User.CreatedOn.ToLocalTime().ToString("MMM d, yyyy") ·
                    @(User.IsEmailConfirmed ? "email confirmed" : "email not confirmed")
                </RadzenText>
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenFormField Text="First Name" Style="flex: 1;">
                <RadzenTextBox @bind-Value="_model.FirstName" Name="FirstName" />
                <RadzenRequiredValidator Component="FirstName" Text="First name is required." />
            </RadzenFormField>
            <RadzenFormField Text="Last Name" Style="flex: 1;">
                <RadzenTextBox @bind-Value="_model.LastName" Name="LastName" />
                <RadzenRequiredValidator Component="LastName" Text="Last name is required." />
            </RadzenFormField>
        </RadzenStack>

        <RadzenFormField Text="Username">
            <ChildContent>
                <RadzenTextBox @bind-Value="_model.Username" Name="Username" />
            </ChildContent>
            <Helper>
                <RadzenText TextStyle="TextStyle.Caption">Used by players to find friends, never to sign in.</RadzenText>
            </Helper>
        </RadzenFormField>

        @* ── Permissions & visibility ── *@
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Overline" style="color: var(--rz-text-secondary-color);" class="rz-m-0">Access</RadzenText>

            @SwitchRow("Administrator", "Full access to the admin area.",
                () => _model.IsAdmin, v => _model.IsAdmin = v)
            @SwitchRow("Locked out", "Blocks the user from signing in.",
                () => _model.IsLockedOut, v => _model.IsLockedOut = v)
            @SwitchRow("Hidden from search", "User won't appear in player search.",
                () => _model.IsSearchHidden, v => _model.IsSearchHidden = v)
        </RadzenStack>

        @* ── Public stats page ── *@
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Overline" style="color: var(--rz-text-secondary-color);" class="rz-m-0">Public stats page</RadzenText>

            @SwitchRow("Public", "Publishes their stats at fairwayfinder.pro/golf/{link} on the next landing build.",
                () => _model.IsPublic, v => _model.IsPublic = v)

            <RadzenFormField Text="Profile link">
                <ChildContent>
                    <RadzenTextBox @bind-Value="_model.PublicSlug" Name="PublicSlug" Placeholder="Defaults to the username" />
                </ChildContent>
                <Helper>
                    @if (!string.IsNullOrWhiteSpace(User.PublicProfile.Slug))
                    {
                        <RadzenLink Path="@($"https://fairwayfinder.pro/golf/{User.PublicProfile.Slug}/")" Target="_blank"
                                    Text="@($"fairwayfinder.pro/golf/{User.PublicProfile.Slug}")" />
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Caption">Letters, numbers and hyphens.</RadzenText>
                    }
                </Helper>
            </RadzenFormField>

            @SwitchRow("Strokes gained", "Show the strokes-gained chart.",
                () => _model.ShowStrokesGained, v => _model.ShowStrokesGained = v)
            @SwitchRow("Recent rounds", "Show the five most recent rounds.",
                () => _model.ShowRecentRounds, v => _model.ShowRecentRounds = v)
            @SwitchRow("Course names", "Name the courses. Off hides every course name.",
                () => _model.ShowCourseNames, v => _model.ShowCourseNames = v)
        </RadzenStack>

        @if (_errors.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Small">
                <ul style="margin: 0; padding-left: 1.25rem;">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </RadzenAlert>
        }

        @* ── Actions ── *@
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="View rounds" Icon="sports_golf" ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined" Size="ButtonSize.Small" ButtonType="ButtonType.Button"
                              Click="OnViewRounds" />
                <RadzenButton Text="Send password reset" Icon="lock_reset" ButtonStyle="ButtonStyle.Secondary"
                              Variant="Variant.Outlined" Size="ButtonSize.Small" ButtonType="ButtonType.Button"
                              IsBusy="_sendingReset" BusyText="Sending..." Click="OnSendPasswordReset" />
                <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Outlined" Size="ButtonSize.Small" ButtonType="ButtonType.Button"
                              IsBusy="_busy" Click="OnDelete" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button"
                              Click="@(() => DialogService.Close(false))" />
                <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              ButtonType="ButtonType.Submit" IsBusy="_busy" BusyText="Saving..." />
            </RadzenStack>
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public UserAdminDto User { get; set; } = default!;

    /// <summary>The signed-in admin. Recorded against the send, never used to identify the target.</summary>
    [Parameter] public string ActingAdminUserId { get; set; } = string.Empty;

    private EditUserModel _model = new();
    private List<string> _errors = new();
    private bool _busy;
    private bool _sendingReset;

    protected override void OnParametersSet()
    {
        _model = new EditUserModel
        {
            FirstName = User.FirstName,
            LastName = User.LastName,
            Username = User.Username,
            IsAdmin = User.IsAdmin,
            IsLockedOut = User.IsLockedOut,
            IsSearchHidden = User.IsSearchHidden,
            IsPublic = User.PublicProfile.IsPublic,
            PublicSlug = User.PublicProfile.Slug ?? string.Empty,
            ShowStrokesGained = User.PublicProfile.ShowStrokesGained,
            ShowRecentRounds = User.PublicProfile.ShowRecentRounds,
            ShowCourseNames = User.PublicProfile.ShowCourseNames
        };
    }

    private async Task OnSubmit()
    {
        _busy = true;
        _errors.Clear();

        var nameResult = await UserAdminService.UpdateUserAsync(User.Id, new UpdateUserDto
        {
            FirstName = _model.FirstName,
            LastName = _model.LastName
        });
        if (!nameResult.Succeeded) _errors.AddRange(nameResult.Errors.Select(e => e.Description));

        // Keyed on the target user (User.Id), never the acting admin. Same rules as the app.
        if (UsernameRules.Normalize(_model.Username) != User.Username)
        {
            var r = await UsernameService.ChangeUsernameAsync(User.Id, _model.Username);
            if (!r.Success) _errors.Add(r.Error ?? "Could not change the username.");
        }

        if (_model.IsAdmin != User.IsAdmin)
        {
            var r = await UserAdminService.ToggleAdminRoleAsync(User.Id);
            if (!r.Succeeded) _errors.AddRange(r.Errors.Select(e => e.Description));
        }

        if (_model.IsLockedOut != User.IsLockedOut)
        {
            var r = await UserAdminService.SetLockoutAsync(User.Id, _model.IsLockedOut);
            if (!r.Succeeded) _errors.AddRange(r.Errors.Select(e => e.Description));
        }

        if (_model.IsSearchHidden != User.IsSearchHidden)
        {
            var r = await UserAdminService.SetSearchHiddenAsync(User.Id, _model.IsSearchHidden);
            if (!r.Succeeded) _errors.AddRange(r.Errors.Select(e => e.Description));
        }

        // Keyed on the target user; the acting admin is only the audit stamp. Same rules as the app.
        var current = User.PublicProfile;
        if (_model.IsPublic != current.IsPublic
            || PublicSlugRules.Normalize(_model.PublicSlug) != (current.Slug ?? string.Empty)
            || _model.ShowStrokesGained != current.ShowStrokesGained
            || _model.ShowRecentRounds != current.ShowRecentRounds
            || _model.ShowCourseNames != current.ShowCourseNames)
        {
            var r = await UserAdminService.SetPublicProfileAsync(User.Id, new PublicProfileSettingsRequest
            {
                IsPublic = _model.IsPublic,
                Slug = _model.PublicSlug,
                ShowStrokesGained = _model.ShowStrokesGained,
                ShowRecentRounds = _model.ShowRecentRounds,
                ShowCourseNames = _model.ShowCourseNames
            }, ActingAdminUserId);
            if (r.Status != PublicProfileSettingsStatus.Ok) _errors.Add(r.Error ?? "Could not update the public page.");
        }

        _busy = false;

        if (_errors.Count == 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "User Updated",
                Detail = $"Changes to {User.FullName} have been saved.",
                Duration = 4000
            });
            DialogService.Close(true);
        }
    }

    private async Task OnDelete()
    {
        var confirmed = await DialogService.OpenAsync<DeleteConfirmDialog>("Delete User",
            new Dictionary<string, object>
            {
                { "EntityName", string.IsNullOrWhiteSpace(User.FullName) ? User.Email : User.FullName },
                { "WarningMessage", "This permanently removes the user and all associated data." }
            },
            new DialogOptions { Width = "400px", CloseDialogOnOverlayClick = false });

        if (confirmed is not true) return;

        _busy = true;
        var result = await UserAdminService.DeleteUserAsync(User.Id);
        _busy = false;

        if (result.Succeeded)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "User Deleted",
                Detail = $"{User.FullName} has been deleted.",
                Duration = 4000
            });
            DialogService.Close(true);
        }
        else
        {
            _errors = result.Errors.Select(e => e.Description).ToList();
        }
    }

    // Sends the golfer the same link the app's own "forgot password" flow would mail them, for
    // the case where they can't receive or follow that one themselves. The admin never sees or
    // sets the password — the link still has to be redeemed on the user's device.
    private async Task OnSendPasswordReset()
    {
        var confirmed = await DialogService.Confirm(
            $"Email a password reset link to {User.Email}? Any link sent earlier stops working once this one is used.",
            "Send Password Reset",
            new ConfirmOptions { OkButtonText = "Send", CancelButtonText = "Cancel" });

        if (confirmed != true) return;

        _sendingReset = true;
        var result = await PasswordResetService.SendResetLinkAsAdminAsync(User.Id, ActingAdminUserId);
        _sendingReset = false;

        NotificationService.Notify(new NotificationMessage
        {
            Severity = result.Success ? NotificationSeverity.Success : NotificationSeverity.Error,
            Summary = result.Success ? "Reset Link Sent" : "Send Failed",
            Detail = result.Success
                ? $"A password reset link is on its way to {User.Email}."
                : result.Error ?? "Could not send the reset link.",
            Duration = result.Success ? 4000 : 6000
        });
    }

    private void OnViewRounds()
    {
        DialogService.Close(false);
        NavigationManager.NavigateTo($"/rounds?userId={Uri.EscapeDataString(User.Id)}");
    }

    private RenderFragment SwitchRow(string label, string hint, Func<bool> get, Action<bool> set) =>@<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@label</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" style="color: var(--rz-text-secondary-color);" class="rz-m-0">@hint</RadzenText>
        </RadzenStack>
        <RadzenSwitch Value="get()" Change="@(args => set((bool)args))" />
    </RadzenStack>;

    private class EditUserModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public bool IsAdmin { get; set; }
        public bool IsLockedOut { get; set; }
        public bool IsSearchHidden { get; set; }
        public bool IsPublic { get; set; }
        public string PublicSlug { get; set; } = string.Empty;
        public bool ShowStrokesGained { get; set; } = true;
        public bool ShowRecentRounds { get; set; } = true;
        public bool ShowCourseNames { get; set; } = true;
    }
}
