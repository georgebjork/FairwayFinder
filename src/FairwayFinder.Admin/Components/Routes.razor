@using FairwayFinder.Admin.Components.Auth.Components
@using FairwayFinder.Admin.Components.Error

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(FairwayFinder.Admin.Components.Error.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <Authorizing>
                <text>Authorizing...</text>
            </Authorizing>
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <AccessDeniedMessage />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
