@inject NavigationManager NavigationManager

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0" class="rz-p-2">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenButton Icon="menu" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                          Click="@OnToggleSidebar" />
            <a href="/" style="text-decoration: none; color: inherit;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenImage Path="branding/wordmark-white.png" AlternateText="FairwayFinder" class="ff-wordmark" />
                    <span class="ff-admin-badge">Admin</span>
                </RadzenStack>
            </a>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenAppearanceToggle />
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenGravatar Email="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" />
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="color: var(--rz-on-primary);">@context.User.Identity?.Name</RadzenText>
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Sign Out" Icon="logout" Path="/authentication/logout" />
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
}
