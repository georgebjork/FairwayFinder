@using FairwayFinder.Admin.Components.Shared.Layout.Breadcrumb

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" class="rz-px-4" Style="min-height: var(--rz-header-min-height);">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenButton Icon="menu" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                          Click="@OnToggleSidebar" aria-label="Toggle navigation" />
            <Breadcrumb />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenAppearanceToggle LightTheme="default" DarkTheme="dark" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <span class="ff-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@context.User.Identity?.Name</RadzenText>
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Sign out" Icon="logout" Path="/authentication/logout" />
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name.Trim()[0]).ToString();
}
