{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning",
        "System.Net.Http": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "fairwayfinder": "Host=localhost;Database=db-fairwayfinder;Username=user;Password=password",
    "fairwayfinderlogs": "Host=localhost;Database=db-fairwayfinder-logs;Username=user;Password=password"
  },
  "Jwt": {
    "Issuer": "FairwayFinder.Api",
    "Audience": "FairwayFinder.Mobile",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Apns": {
    "BundleId": "",
    "KeyId": "",
    "TeamId": "",
    "P8Contents": "",
    "UseSandbox": true
  },
  "Auth": {
    "PasswordResetUrlBase": "https://api.fairwayfinder.pro/reset-password"
  },
  "Invites": {
    "RegistrationUrlBase": "https://api.fairwayfinder.pro/register",
    "AppInstallUrl": "https://testflight.apple.com/join/rscJqcFW"
  },
  "RequestLogging": {
    "Enabled": true,
    "RetentionDays": 30,
    "ExcludedPathPrefixes": [
      "/health",
      "/alive",
      "/openapi",
      "/scalar",
      "/.well-known",
      "/register",
      "/reset-password"
    ],
    "ChannelCapacity": 10000
  }
}
