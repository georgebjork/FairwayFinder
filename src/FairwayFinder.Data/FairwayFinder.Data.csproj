<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\FairwayFinder.Identity\FairwayFinder.Identity.csproj" />
      <ProjectReference Include="..\FairwayFinder.Shared\FairwayFinder.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- EF Core and everything built on it (Identity.EF, DataProtection.EF, Npgsql) stay on 10.x
           while the solution targets net11.0: Npgsql.EntityFrameworkCore.PostgreSQL has no 11.0 GA
           yet and the provider's major must match EF Core's. Move them to 11 together once it ships.
           DataProtection itself is referenced directly so it rides the 11.0 runtime release. -->
      <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="11.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <!-- Pulled in transitively by DataProtection to serialize the key ring. Pinned to the first
           version clearing its outstanding advisories; it is a leaf, so this forces nothing else up. -->
      <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
      <PackageReference Include="Npgsql" Version="10.0.1" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    </ItemGroup>

</Project>
