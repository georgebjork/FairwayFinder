@* One nine of a round's card: hole, yardage, par, score (ScoreMark), and the tracked stat rows when
   the round has them. A full round renders two of these, Out and In, so neither needs to scroll. *@

<div class="scorecard-scroll">
    <table class="scorecard">
        <thead>
            <tr>
                <th scope="row">Hole</th>
                @foreach (var hole in Holes)
                {
                    <th scope="col">@hole.HoleNumber</th>
                }
                <th scope="col" class="tot">@TotalLabel</th>
            </tr>
        </thead>
        <tbody>
            <tr class="meta">
                <th scope="row">Yards</th>
                @foreach (var hole in Holes)
                {
                    <td>@hole.Yardage</td>
                }
                <td class="tot">@Holes.Sum(h => h.Yardage)</td>
            </tr>
            <tr class="meta">
                <th scope="row">Par</th>
                @foreach (var hole in Holes)
                {
                    <td>@hole.Par</td>
                }
                <td class="tot">@Holes.Sum(h => h.Par)</td>
            </tr>
            <tr class="score">
                <th scope="row">Score</th>
                @foreach (var hole in Holes)
                {
                    <td><ScoreMark Strokes="hole.Score" Par="hole.Par" /></td>
                }
                <td class="tot">@Holes.Sum(h => h.Score)</td>
            </tr>
            @if (Holes.Any(h => h.Putts is not null))
            {
                <tr class="meta">
                    <th scope="row">Putts</th>
                    @foreach (var hole in Holes)
                    {
                        <td>@hole.Putts</td>
                    }
                    <td class="tot">@Holes.Sum(h => h.Putts ?? 0)</td>
                </tr>
            }
            @if (Holes.Any(h => h.Fairway is not null))
            {
                <tr class="meta">
                    <th scope="row">Fairway</th>
                    @foreach (var hole in Holes)
                    {
                        <td>@Hit(hole.Fairway)</td>
                    }
                    <td class="tot">@Holes.Count(h => h.Fairway == true)</td>
                </tr>
            }
            @if (Holes.Any(h => h.Green is not null))
            {
                <tr class="meta">
                    <th scope="row">Green</th>
                    @foreach (var hole in Holes)
                    {
                        <td>@Hit(hole.Green)</td>
                    }
                    <td class="tot">@Holes.Count(h => h.Green == true)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<PublicScorecardHole> Holes { get; set; } = default!;
    [Parameter, EditorRequired] public string TotalLabel { get; set; } = default!;

    private static RenderFragment Hit(bool? hit) => hit switch
    {
        true => @<span class="hit" title="Hit">●</span>,
        false => @<span class="miss" title="Missed">○</span>,
        null => @<span></span>
    };
}
