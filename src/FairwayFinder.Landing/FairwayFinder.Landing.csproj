<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The site is served by App Platform's CDN, which compresses on its own. -->
        <CompressionEnabled>false</CompressionEnabled>
        <!-- App Platform's .NET buildpack publishes with a runtime identifier, then runs the build
             command in a shell without `dotnet` on the PATH. Self-contained, the published launcher
             (bin/publish/FairwayFinder.Landing) runs the generator without one. Only when a runtime
             is given, so `dotnet run` locally is unaffected. -->
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <!-- Copied as-is into the generated site; the generator reads them from the build output. -->
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
        <!-- The OG card renderer loads this itself: SkiaSharp's Linux NoDependencies build has no
             fontconfig, so App Platform's build machine has no default typeface to fall back on. -->
        <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="4.156.0" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    </ItemGroup>

</Project>
