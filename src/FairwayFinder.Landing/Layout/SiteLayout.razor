@* Document shell shared by every page. Pages wrap their content in this component; there is no
   router, so Razor's @layout directive doesn't apply. *@

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <meta name="description" content="@Site.Description">
    <meta name="theme-color" content="#6a3de7">
    <meta property="og:type" content="website">
    <meta property="og:title" content="@Title">
    <meta property="og:description" content="@Site.Description">
    <meta property="og:url" content="@Site.Url">
    <meta property="og:image" content="@($"{Site.Url}/img/icon-512.png")">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <link rel="stylesheet" href="/site.css">
</head>
<body>
    @ChildContent
    <footer class="footer">
        <div class="wrap footer-row">
            <span>&copy; @DateTime.UtcNow.Year @Site.Name</span>
            <a href="@Site.AppInstallUrl">Get the app</a>
        </div>
    </footer>
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = Site.Name;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
